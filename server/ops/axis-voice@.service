[Unit]
Description=Axis voice engine (%i)
After=network.target

[Service]
DynamicUser=true
User=axis-voice-%i
WorkingDirectory=/opt/axis-voice
EnvironmentFile=/etc/axis-voice/%i.env
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/axis-voice/.venv/bin/python -m uvicorn axis_voice_service:create_app --factory --host 127.0.0.1 --port ${AXIS_VOICE_PORT} --workers 1 --limit-concurrency 4 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
MemoryHigh=260M
MemoryMax=300M
MemorySwapMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
